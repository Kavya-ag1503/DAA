#include <stdio.h>
#include <stdlib.h>

struct Node {
    char ch;
    int freq;
    struct Node *left, *right;
};

struct Node* createNode(char ch, int freq) {
    struct Node* temp = malloc(sizeof(struct Node));

    temp->ch = ch;
    temp->freq = freq;
    temp->left = NULL;
    temp->right = NULL;

    return temp;
}

void printCodes(struct Node* root, int code[], int top) {
    if (root->left == NULL && root->right == NULL) {
        printf("%c: ", root->ch);

        if (top == 0)
            printf("0");

        for (int i = 0; i < top; i++)
            printf("%d", code[i]);

        printf("\n");
        return;
    }

    if (root->left != NULL) {
        code[top] = 0;
        printCodes(root->left, code, top + 1);
    }

    if (root->right != NULL) {
        code[top] = 1;
        printCodes(root->right, code, top + 1);
    }
}

int main() {
    int n, freq;
    char ch;
    struct Node* nodes[100];
    int code[100];

    printf("Enter number of characters: ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Invalid number of characters\n");
        return 1;
    }

    for (int i = 0; i < n; i++) {
        printf("Enter character: ");
        scanf(" %c", &ch);

        printf("Enter frequency: ");
        scanf("%d", &freq);

        if (freq <= 0) {
            printf("Frequency must be positive\n");
            return 1;
        }

        nodes[i] = createNode(ch, freq);
    }

    while (n > 1) {
        for (int i = 0; i < n - 1; i++) {
            for (int j = i + 1; j < n; j++) {
                if (nodes[i]->freq > nodes[j]->freq) {
                    struct Node* temp = nodes[i];
                    nodes[i] = nodes[j];
                    nodes[j] = temp;
                }
            }
        }

        struct Node* left = nodes[0];
        struct Node* right = nodes[1];

        struct Node* parent = createNode(
            '-', left->freq + right->freq
        );

        parent->left = left;
        parent->right = right;

        nodes[0] = parent;
        nodes[1] = nodes[n - 1];

        n--;
    }

    printf("\nHuffman Codes:\n");
    printCodes(nodes[0], code, 0);

    return 0;
}
